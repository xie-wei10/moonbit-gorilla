import {
  "xie-wei10/gorilla" @lib,
  "moonbitlang/core/string" @strconv,
  "moonbitlang/core/json",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "run",
        "compress_text",
        "decompress_text",
        "codec_json",
        "archive_json",
      ],
      "format": "esm",
    },
  },
)
