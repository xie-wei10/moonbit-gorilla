{
  "title": "保留特殊浮点位模式的区间归档",
  "scope": "原创合成时间序列，含负零与 NaN payload。",
  "steps": [
    {
      "args": [
        "tools/archive-cli.mjs",
        "encode",
        "examples/use-case/samples.txt",
        "{out}/samples.gor2",
        "--block-size",
        "2"
      ]
    },
    {
      "args": [
        "tools/archive-cli.mjs",
        "range",
        "{out}/samples.gor2",
        "1000",
        "2000",
        "--verify-all"
      ]
    },
    {
      "args": [
        "tools/archive-cli.mjs",
        "verify",
        "{out}/samples.gor2"
      ]
    }
  ],
  "expected": "闭区间返回负零 bits=9223372036854775808 与 NaN bits=9221120237041090626，完整校验成功。"
}
